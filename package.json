{
  "name": "netrunner-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:artifact": "vite build --base ./ --outDir dist-artifact && node scripts/artifact-page.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "preact": "10.29.8"
  }
}
